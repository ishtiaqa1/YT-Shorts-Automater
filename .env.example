# Server
PORT=8787
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts_studio

# Client (Vite) — copy to .env for local dev
VITE_API_URL=http://localhost:8787

# Text-to-speech — Google Cloud Text-to-Speech API (enable API + create API key in same GCP project)
GOOGLE_TTS_API_KEY=
# Optional voice overrides (defaults: en-US / en-US-Neural2-D)
# GOOGLE_TTS_LANGUAGE_CODE=en-US
# GOOGLE_TTS_VOICE_NAME=en-US-Neural2-D
# GOOGLE_TTS_SPEAKING_RATE=1

# YouTube Data API — create OAuth 2.0 credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/api/youtube/oauth/callback

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# App URL for Stripe redirects
PUBLIC_APP_URL=http://localhost:5173
