# Server
PORT=8787

# --- Minimum to run API + login + projects (local) ---
# DATABASE_URL  (Postgres must exist and match this URL)
# JWT_SECRET    (any long random string)
# Optional: VITE_API_URL for the browser bundle (see below). Dev often uses Vite proxy with empty base.
#
# --- Feature keys (omit what you don’t use) ---
# GEMINI_API_KEY   — AI-generated scripts + spoken transcription (if no OpenAI)
# OPENAI_API_KEY   — Whisper transcription (optional; Gemini can transcribe if GEMINI_API_KEY is set)
# GOOGLE_* / ElevenLabs — see TTS section for voiceovers
# GOOGLE_CLIENT_* + YOUTUBE_REDIRECT_URI — connect channel / scheduling uploads
#
# Optional: full paths if `ffmpeg` / `ffprobe` are not on PATH (Windows: use forward slashes — see comment in .env)
# FFMPEG_PATH=C:/Users/YOU/AppData/Local/Microsoft/WinGet/Packages/.../bin/ffmpeg.exe
# FFPROBE_PATH=C:/Users/YOU/.../bin/ffprobe.exe
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts_studio

# Client (Vite) — optional absolute API origin (no trailing /api).
# With `npm run dev`, leave this unset so the browser uses same-origin `/api` (proxy → localhost API).
# If you set this to staging/LAN/prod while on Vite, your UI will not hit the code in this repo.
# To force direct fetch to localhost in dev: set VITE_API_URL and VITE_DEV_USE_CONFIGURED_ORIGIN=1.
# VITE_API_URL=http://localhost:8787

# Text-to-speech — Google Cloud Text-to-Speech (enable API on the project)
#
# If org policy blocks service account KEY files (iam.disableServiceAccountKeyCreation), use user ADC:
#   1) Install Google Cloud SDK, then run: gcloud auth application-default login
#   2) Set GOOGLE_TTS_USE_ADC=1 (uses your Google account; grant yourself Cloud Text-to-Speech roles on the project)
#   3) Set quota project (required for user ADC) — pick ONE:
#      gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#      OR add: GOOGLE_CLOUD_QUOTA_PROJECT=YOUR_PROJECT_ID
# GOOGLE_TTS_USE_ADC=1
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id
#
# Optional: service account JSON path (only if your org allows creating keys)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_TTS_SERVICE_ACCOUNT_PATH=C:\path\to\tts-only-sa.json
#
# Or API key (restrict key to Cloud Text-to-Speech API)
# GOOGLE_TTS_API_KEY=
# Optional voice overrides (defaults: en-US / en-US-Neural2-D)
# GOOGLE_TTS_LANGUAGE_CODE=en-US
# GOOGLE_TTS_VOICE_NAME=en-US-Neural2-D
# GOOGLE_TTS_SPEAKING_RATE=1

# ElevenLabs (preferred when set — replaces Google / local TTS for renders)
# ELEVENLABS_API_KEY=
# Optional: Marcus | Aria | Nova | Echo | River | Sol, or raw ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE=Marcus
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# Optional speed (subset of models — unset if ElevenLabs returns 400): mirrors speaking rate ~1.0
# ELEVENLABS_SPEAKING_RATE=1

# Soft cap surfaced on GET /api/projects/meta/quota (when you wire quotas)
# FREE_RENDERS_PER_WEEK_CAP=999

# Rate limits (per IP / authenticated user defaults via express-rate-limit)
# RATE_LIMIT_GLOBAL_PER_MIN=200
# RATE_LIMIT_AI_PER_MIN=10
# RATE_LIMIT_RENDER_PER_MIN=5

# Daily render caps (enforceRenderDailyCap on POST /render)
# FREE_RENDERS_PER_DAY=8
# PRO_RENDERS_PER_DAY_CAP=120
# DISABLE_RENDER_DAILY_CAP=1   # handy for local dev/testing

# Kill stuck FFmpeg encodes after this many ms (default 45 minutes if unset)
# RENDER_FFMPEG_TIMEOUT_MS=

# x264 speed vs quality: ultrafast … veryfast (default) … fast … medium (slower = smaller / sharper)
# RENDER_FFMPEG_PRESET=veryfast
# RENDER_FFMPEG_CRF=23
#
# Reddit: full-frame “post card” at the start of the MP4 when `reddit_permalink` is set (default ~3.5s).
# YouTube custom thumbnails use a frame *after* this beat so the poster is gameplay + captions, not the card.
# REDDIT_INTRO_SECONDS=3.5

# Full-audio pass to trim caption timing to speech (slower). Set 0 to skip for faster renders.
# RENDER_SILENCE_DETECT=1

# While status=rendering, bump `updated_at` this often (ms) so a crashed API can be detected
# RENDER_HEARTBEAT_MS=20000
# If still rendering with no heartbeat bump for this many minutes, mark failed (default 25, max 120)
# STALE_RENDERING_MINUTES=25

# Admin dashboard (exact match to user email, case-insensitive)
# ADMIN_EMAIL=you@example.com

# Email (Resend) — optional; without RESEND_API_KEY the server logs a stub instead of sending
# RESEND_API_KEY=
# EMAIL_FROM=ClipForge <onboarding@yourdomain.com>
# WEEKLY_SUMMARY_TO=ops@yourdomain.com

# AI script drafting + spoken-audio transcription — Google AI Studio key (Gemini API)
# Omit OPENAI_API_KEY to use Gemini only for transcription.
# GEMINI_API_KEY=

# Optional: OpenAI Whisper (tried first if set). Omit for Google-only.
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1

# App name shown in transactional emails (optional)
# APP_NAME=ClipForge

# API smoke (npm run test:api — see scripts/api-projects-smoke.mjs)
# SHORTS_API_URL=http://localhost:8787
# SHORTS_TEST_EMAIL=
# SHORTS_TEST_PASSWORD=
# SHORTS_SPOKEN_FILE=C:/path/to/short-sample.wav  # reliable spoken test when synthetic audio fails STT
# SHORTS_SKIP_REDDIT=1 SHORTS_SKIP_AI=1 SHORTS_SKIP_SPOKEN=1

# YouTube Data API — OAuth 2.0 Client type must be “Web application” (not Desktop / iOS / Android).
# Put each value on its own line — an unquoted inline # after the value is treated as a comment and can truncate the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/api/youtube/oauth/callback

# TikTok — Login Kit + Content Posting (direct video post). Redirect URI must be https in the TikTok portal (use ngrok or staging for local dev).
# TIKTOK_CLIENT_KEY is the “Client key” from the TikTok developer app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-api-host.example.com/api/tiktok/oauth/callback
# Optional comma-separated scopes (default: user.info.basic,video.publish)
# TIKTOK_SCOPES=user.info.basic,video.publish
# YOUTUBE_SKIP_CUSTOM_THUMBNAIL_ON_UPLOAD=1  — skip thumbnails.set after insert (some channels report Shorts classification issues with custom posters; try if uploads stay long-form).
#
# Scheduled uploads append ` #Shorts` to the YouTube title when missing (helps Shorts classification for API uploads).
# YOUTUBE_SKIP_SHORTS_TITLE_TAG=1

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
#
# Subscribe the webhook endpoint to:
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_succeeded (optional revenue estimates into diagnostics).

# SPA origin only (no /app path): must match the browser URL (scheme + host + port),
# including localhost vs 127.0.0.1, so OAuth returns to a tab that still has your login token.
PUBLIC_APP_URL=http://localhost:5173
