# Server
PORT=8787

# Optional: full paths if `ffmpeg` / `ffprobe` are not on PATH (Windows: use forward slashes — see comment in .env)
# FFMPEG_PATH=C:/Users/YOU/AppData/Local/Microsoft/WinGet/Packages/.../bin/ffmpeg.exe
# FFPROBE_PATH=C:/Users/YOU/.../bin/ffprobe.exe
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts_studio

# Client (Vite) — copy to .env for local dev
VITE_API_URL=http://localhost:8787

# Text-to-speech — Google Cloud Text-to-Speech (enable API on the project)
#
# If org policy blocks service account KEY files (iam.disableServiceAccountKeyCreation), use user ADC:
#   1) Install Google Cloud SDK, then run: gcloud auth application-default login
#   2) Set GOOGLE_TTS_USE_ADC=1 (uses your Google account; grant yourself Cloud Text-to-Speech roles on the project)
#   3) Set quota project (required for user ADC) — pick ONE:
#      gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#      OR add: GOOGLE_CLOUD_QUOTA_PROJECT=YOUR_PROJECT_ID
# GOOGLE_TTS_USE_ADC=1
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id
#
# Optional: service account JSON path (only if your org allows creating keys)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_TTS_SERVICE_ACCOUNT_PATH=C:\path\to\tts-only-sa.json
#
# Or API key (restrict key to Cloud Text-to-Speech API)
# GOOGLE_TTS_API_KEY=
# Optional voice overrides (defaults: en-US / en-US-Neural2-D)
# GOOGLE_TTS_LANGUAGE_CODE=en-US
# GOOGLE_TTS_VOICE_NAME=en-US-Neural2-D
# GOOGLE_TTS_SPEAKING_RATE=1

# YouTube Data API — OAuth 2.0 Client type must be “Web application” (not Desktop / iOS / Android).
# Put each value on its own line — an unquoted inline # after the value is treated as a comment and can truncate the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/api/youtube/oauth/callback

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# SPA origin only (no /app path): must match the browser URL (scheme + host + port),
# including localhost vs 127.0.0.1, so OAuth returns to a tab that still has your login token.
PUBLIC_APP_URL=http://localhost:5173
